# ============================================================
# FlappyBird .gitignore
# 目标：只提交"源码 + 素材 + 文档"，不提交环境、产物、个人配置
# ============================================================

# ---------- Python 虚拟环境 ----------
.venv/
venv/
env/
ENV/
*.egg-info/
pip-wheel-metadata/

# ---------- Python 字节码与缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# ---------- 运行时产物 ----------
# 最高分存档：因机器而异，属于本地数据，不入库
save/
# 无头截图/调参图表等构建产物
build/
dist/
*.egg
*.whl

# ---------- 编辑器与 IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# ---------- 操作系统 ----------
# macOS 打包产生的资源分叉文件（本项目 res/__MACOSX/ 就是这类垃圾，共 39 个文件）
.DS_Store
.AppleDouble
.LSOverride
._*
__MACOSX/
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~
.directory

# ---------- 临时与备份 ----------
*.tmp
*.bak
*.log
*.orig
*.rej
*.pid
*.seed

# ---------- 本地环境变量（可能含令牌，绝不入库）----------
.env
.env.*
!.env.example

# ---------- 测试/调试临时脚本 ----------
_probe_launcher.py
*.local.py

# ---------- 打包产物 ----------
*.spec
build/*
dist/*
